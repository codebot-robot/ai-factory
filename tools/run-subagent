#!/usr/bin/env python3
import sys
import os
import re
import subprocess
import textwrap

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <agent-name> [schedule]")
        print(f"Example: {sys.argv[0]} my-agent '0 */8 * * *'")
        print(f"Example: {sys.argv[0]} my-agent 'every 8 hours'")
        sys.exit(1)

    agent_name = sys.argv[1]
    schedule = sys.argv[2] if len(sys.argv) > 2 else None

    project_id = os.environ.get("GCP_PROJECT_ID", "my-project")
    agent_image = f"gcr.io/{project_id}/ai-on-gke-agent:latest"

    sleep_seconds = None
    if schedule:
        # Helper to convert schedules to sleep seconds for long-running sandboxes
        m = re.match(r'^every\s+([0-9]+)\s+hours?$', schedule)
        if m:
            sleep_seconds = int(m.group(1)) * 3600
        else:
            m = re.match(r'^every\s+([0-9]+)\s+minutes?$', schedule)
            if m:
                sleep_seconds = int(m.group(1)) * 60
            else:
                m = re.match(r'^every\s+([0-9]+)\s+days?$', schedule)
                if m:
                    sleep_seconds = int(m.group(1)) * 86400
                elif schedule == "daily" or schedule == "0 0 * * *":
                    sleep_seconds = 86400
                elif schedule == "hourly" or schedule == "0 * * * *":
                    sleep_seconds = 3600
                else:
                    # try to parse basic cron
                    m = re.match(r'^0 \*/([0-9]+) \* \* \*$', schedule)
                    if m:
                        sleep_seconds = int(m.group(1)) * 3600
                    else:
                        m = re.match(r'^\*/([0-9]+) \* \* \* \*$', schedule)
                        if m:
                            sleep_seconds = int(m.group(1)) * 60
                        else:
                            print(f"Warning: Could not parse schedule '{schedule}' into an interval. Defaulting to 1 hour.")
                            sleep_seconds = 3600

    env_vars = f"""
                    - name: AGENT_NAME
                      value: {agent_name}"""
    if sleep_seconds:
        env_vars += f"""
                    - name: SLEEP_SECONDS
                      value: "{sleep_seconds}"\
"""

    if sleep_seconds:
        print(f"Running long-lived agent {agent_name} with interval: {sleep_seconds} seconds...")
    else:
        print(f"Running agent {agent_name} immediately...")

    yaml_content = textwrap.dedent(f"""\
        apiVersion: agents.x-k8s.io/v1alpha1
        kind: Sandbox
        metadata:
          generateName: {agent_name}-sandbox-
          labels:
            agent: {agent_name}
        spec:
          podTemplate:
            spec:
              containers:
              - name: agent
                image: {agent_image}
                env:{env_vars}
              restartPolicy: Never
        """)
    
    process = subprocess.run(["kubectl", "create", "-f", "-"], input=yaml_content, text=True)
    if process.returncode == 0:
        print("Sandbox creation requested.")
    else:
        sys.exit(process.returncode)

if __name__ == "__main__":
    main()
