#!/usr/bin/env python3
import sys
import os
import subprocess
import textwrap

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <agent-name>")
        print(f"Example: {sys.argv[0]} my-agent")
        sys.exit(1)

    agent_name = sys.argv[1]

    project_id = os.environ.get("GCP_PROJECT_ID", "my-project")
    agent_image = f"gcr.io/{project_id}/ai-on-gke-agent:latest"

    print(f"Running agent {agent_name}...")
    yaml_content = textwrap.dedent(f"""\
        apiVersion: agents.x-k8s.io/v1alpha1
        kind: Sandbox
        metadata:
          generateName: {agent_name}-sandbox-
          labels:
            agent: {agent_name}
        spec:
          podTemplate:
            spec:
              containers:
              - name: agent
                image: {agent_image}
                env:
                - name: AGENT_NAME
                  value: {agent_name}
              restartPolicy: Always
        """)
    
    process = subprocess.run(["kubectl", "create", "-f", "-"], input=yaml_content, text=True)
    if process.returncode == 0:
        print("Sandbox creation requested.")
    else:
        sys.exit(process.returncode)

if __name__ == "__main__":
    main()
